# Revo QR Upload V1.3
# Copy these values into the container environment manager.
# NEVER commit the real secret to Git.

PORT=8080
STORAGE_DIR=/data/uploads
MAX_FILE_MB=100
PUBLIC_URL=https://upload.example.com

# Required for the internal Quick Print queue API.
# Generate a long random value (at least 32 bytes).
JOB_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
